<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TempCleanerWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TempCleanerWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TempCleaner Pro"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="TempCleaner Pro"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <InfoBar
            x:Name="ElevationBar"
            Title="Running without administrator rights"
            Grid.Row="1"
            Margin="20,0,20,8"
            IsClosable="True"
            IsOpen="False"
            Message="System locations such as the Windows TEMP folder and the Windows Update cache will be skipped."
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button Click="Elevate_Click" Content="Restart as administrator" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="260"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <!-- filled in from the catalogue at runtime -->
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="How it works" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>

        <!--  Persistent action bar: the clean button follows you across every category  -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="20,14" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock
                        x:Name="SummaryText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Nothing selected yet." />
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Measuring in the background. You can start ticking right away."
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar
                        x:Name="Progress"
                        Maximum="100"
                        Minimum="0"
                        Value="0" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <ToggleSwitch
                        x:Name="RecycleSwitch"
                        MinWidth="0"
                        OffContent="Delete permanently"
                        OnContent="Send to Recycle Bin"
                        Toggled="RecycleSwitch_Toggled" />
                    <Button
                        x:Name="StopButton"
                        Click="Stop_Click"
                        Content="Stop"
                        IsEnabled="False" />
                    <Button
                        x:Name="MeasureButton"
                        Click="Measure_Click"
                        Content="Measure sizes" />
                    <Button
                        x:Name="CleanButton"
                        Click="Clean_Click"
                        Content="Clean selected"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
