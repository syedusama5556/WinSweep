<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TempCleanerWinUI.Pages.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TempCleanerWinUI.Models"
    mc:Ignorable="d">

    <Grid Padding="24,12,24,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="Headline" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="Blurb"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="Safe_Click" Content="Safe set" />
                    <Button Click="Standard_Click" Content="Standard set" />
                    <Button Click="Deep_Click" Content="Deep set" />
                    <AppBarSeparator />
                    <Button Click="TickAll_Click" Content="Tick all here" />
                    <Button Click="UntickAll_Click" Content="Untick all" />
                    <AppBarSeparator />
                    <Button
                        x:Name="MeasureCategoryButton"
                        AutomationProperties.Name="Measure this category"
                        Click="MeasureCategory_Click"
                        ToolTipService.ToolTip="Scan only the locations on this page">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                            <TextBlock Text="Measure this category" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <AutoSuggestBox
                x:Name="FilterBox"
                Grid.Column="1"
                MinWidth="220"
                MaxWidth="320"
                PlaceholderText="Filter these items"
                QueryIcon="Find"
                TextChanged="FilterBox_TextChanged" />
        </Grid>

        <!--  Sweep root, only meaningful on the Developer category  -->
        <Grid
            x:Name="SweepRow"
            Grid.Row="2"
            ColumnSpacing="10"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Project sweep root" />
            <TextBox
                x:Name="SweepRootBox"
                Grid.Column="1"
                LostFocus="SweepRootBox_LostFocus" />
            <Button
                Grid.Column="2"
                Click="Browse_Click"
                Content="Browse..." />
        </Grid>

        <ListView
            x:Name="ItemList"
            Grid.Row="3"
            Margin="0,0,0,12"
            ItemContainerTransitions="{x:Null}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CleanItem">
                    <Border
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                MinWidth="0"
                                VerticalAlignment="Center"
                                IsChecked="{x:Bind Selected, Mode=TwoWay}" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Note}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                Grid.Column="2"
                                Padding="10,3"
                                VerticalAlignment="Center"
                                Background="{x:Bind RiskBackground}"
                                CornerRadius="10">
                                <TextBlock
                                    Foreground="{x:Bind RiskBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind RiskText}" />
                            </Border>

                            <TextBlock
                                Grid.Column="3"
                                MinWidth="92"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind SizeText, Mode=OneWay}"
                                TextAlignment="Right" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
