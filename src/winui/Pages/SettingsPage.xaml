<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TempCleanerWinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TempCleanerWinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,16">
        <StackPanel MaxWidth="820" Spacing="14">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Project sweep root" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="The folder searched for generated project folders such as node_modules or build."
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SweepRootBox" LostFocus="SweepRootBox_LostFocus" />
                        <Button
                            Grid.Column="1"
                            Click="Browse_Click"
                            Content="Browse..." />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Deletion" />
                    <ToggleSwitch
                        x:Name="RecycleToggle"
                        Header="Send deleted items to the Recycle Bin"
                        OffContent="Delete permanently"
                        OnContent="Recycle Bin"
                        Toggled="RecycleToggle_Toggled" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Using the Recycle Bin keeps an undo path, but the space is not free until you empty it."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Selection" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Save_Click" Content="Save selection now" />
                        <Button Click="Reset_Click" Content="Reset to defaults" />
                    </StackPanel>
                    <TextBlock
                        x:Name="SavedNote"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Your ticks are saved automatically when the app closes." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
