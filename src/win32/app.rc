#include <windows.h>

// The app icon. Windows uses the first icon in the resource table for the exe,
// so this must stay resource id 1.
1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "infusiblecoder"
            VALUE "FileDescription",  "WinSweep - TempCleaner Pro"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "TempCleanerPro"
            VALUE "LegalCopyright",   "Copyright (c) infusiblecoder. MIT licensed."
            VALUE "OriginalFilename", "TempCleanerPro.exe"
            VALUE "ProductName",      "WinSweep"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
